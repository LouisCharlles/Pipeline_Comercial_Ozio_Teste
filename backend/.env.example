# Copie para backend/.env. Os valores abaixo são os padrões e batem com o docker-compose.yml.

# Django
DJANGO_SECRET_KEY=dev-inseguro-troque-em-producao
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ERP simulado: sucesso | timeout | erro | resposta_invalida
# Trocar o modo exige reiniciar o backend.
ERP_MODO=sucesso
# Atraso artificial de cada chamada ao ERP, em milissegundos.
ERP_LATENCIA_MS=0
# Tempo limite de uma chamada ao ERP, em segundos.
ERP_TIMEOUT_SEGUNDOS=5
